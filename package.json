{
  "name": "@hikesai/web",
  "private": false,
  "version": "1.0.1",
  "type": "module",
  "description": "Hikes — a local agent harness with real tools, sessions and a one-command launcher",
  "author": "Hikes Systems",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hikes-systems/hikes-harness.git"
  },
  "homepage": "https://github.com/hikes-systems/hikes-harness#readme",
  "bugs": {
    "url": "https://github.com/hikes-systems/hikes-harness/issues"
  },
  "license": "MIT",
  "files": [
    "server/",
    "shared/",
    "dist/",
    "docs/showcase/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "hikes": "./server/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.ts --api-only",
    "build": "vite build",
    "prepack": "npm run build",
    "preview": "vite preview",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "clsx": "2.1.1",
    "framer-motion": "^12.43.0",
    "hono": "^4.13.19",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^1.75.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
